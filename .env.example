# ==============================================================================
# STUDIO CULT — Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NEVER commit real credentials, secrets, or API keys to version control.
# ==============================================================================

# Application Environment (production / staging / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://studiocult.in

# Agency Notification Settings
AGENCY_EMAIL=hello@studiocult.in
AGENCY_WHATSAPP_NUMBER=919876543210

# Mail Server Configuration (Optional for SMTP mail delivery)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="STUDIO CULT Agency"
SMTP_FROM_EMAIL=no-reply@studiocult.in

# Analytics & Search Console IDs
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# Security / Anti-Spam
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
